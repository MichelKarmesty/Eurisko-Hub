{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "deps: install all",
      "detail": "npm install in backend, frontend and e2e",
      "dependsOrder": "parallel",
      "dependsOn": ["backend: install", "frontend: install", "e2e: install"],
      "problemMatcher": []
    },
    {
      "label": "backend: prepare data",
      "detail": "Create backend/.data so DB_FILE has a folder to live in",
      "type": "shell",
      "command": "node -e \"require('fs').mkdirSync('.data',{recursive:true})\"",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "backend: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "backend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "backend: dev",
      "detail": "NestJS on :3000 via `npm run start` (the compiled build). After changing backend/src, re-run the build (this task does it for you). backend/.env is loaded automatically (src/env.ts).",
      "type": "shell",
      "command": "npm run start",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "DB_FILE": "${workspaceFolder}/backend/.data/hub.sqlite",
          "AI_API_KEY": "${env:AI_API_KEY}",
          "AI_FALLBACK_MODEL": "qwen/qwen3.8-27b"
        }
      },
      "dependsOn": ["backend: prepare data", "backend: build"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "backend: dev (.env)",
      "detail": "Same as `backend: dev` (npm run start) but relying only on backend/.env, which src/env.ts loads by itself — copy it from .env.example. Builds first, then runs the compiled server.",
      "type": "shell",
      "command": "npm run start",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "dependsOn": ["backend: prepare data", "backend: build"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "detail": "Vite dev server on :5173 (proxies /api to the backend on :3000)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "e2e: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/e2e" },
      "problemMatcher": []
    },
    {
      "label": "dev: backend + frontend",
      "detail": "▶ START HERE — starts both processes in parallel, then open http://localhost:5173",
      "dependsOrder": "parallel",
      "dependsOn": ["backend: dev (.env)", "frontend: dev"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test: backend",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "test: ai-eval",
      "detail": "The 8 AI intake eval cases (cases 1-5 run for real when AI_API_KEY is set)",
      "type": "shell",
      "command": "npm run test:ai-eval",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "test: all (backend + live + UI + browser)",
      "detail": "Self-contained: builds, runs every suite, starts its own isolated API, tears down",
      "type": "shell",
      "command": "node scripts/run-tests.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
