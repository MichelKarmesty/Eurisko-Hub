# ────────────────────────────────────────────────────────────────────────────
# Eurisko Hub — backend environment TEMPLATE
#
# Copy this file to `backend/.env` and fill in your values:
#     Windows PowerShell:  Copy-Item .env.example .env
#     macOS/Linux:         cp .env.example .env
#
# `backend/.env` is gitignored — never commit real secrets.
# Run with (VS Code task "backend: dev (.env)", or by hand):
#     node --env-file=.env dist/main.js
# ────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
DB_FILE=./.data/hub.sqlite
ADMIN_EMAIL=admin@eurisko.com
ADMIN_PASSWORD=Admin123!
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# ── AI intake (optional) ─────────────────────────────────────────────────────
# With no key the app still works: it answers from the labelled offline
# classifier. Free key: https://console.groq.com/keys
AI_ENABLED=true
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
# Tried when the primary model is rate-limited (429), down, or retired:
AI_FALLBACK_MODEL=qwen/qwen3.8-27b
AI_TIMEOUT_MS=15000
AI_OFFLINE_FALLBACK=true

# ── Password-reset email (optional) ──────────────────────────────────────────
# With no provider the reset link is printed to the backend console (and shown
# in the UI outside production). For real email, set the SMTP block below.
# Gmail:   smtp.gmail.com           Outlook/Hotmail: smtp-mail.outlook.com
# Use an APP PASSWORD (not your normal login) when 2-factor auth is on.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Eurisko Hub <no-reply@eurisko.local>
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
# Outside production the reset token is also returned in the API response.
# Set to false to disable that. NODE_ENV=production always disables it.
PASSWORD_RESET_RETURN_TOKEN=true
