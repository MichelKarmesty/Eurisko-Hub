# ────────────────────────────────────────────────────────────────────────────
# Eurisko Hub — backend environment TEMPLATE
#
# Copy this file to `backend/.env` and fill in your values:
#     Windows PowerShell:  Copy-Item .env.example .env
#     macOS/Linux:         cp .env.example .env
#
# `backend/.env` is gitignored — never commit real secrets.
# Run with (VS Code task "backend: dev (.env)", or by hand):
#     node --env-file=.env dist/main.js
# ────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
DB_FILE=./.data/hub.sqlite
ADMIN_EMAIL=admin@eurisko.com
ADMIN_PASSWORD=Admin123!
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# ── AI intake (optional) ─────────────────────────────────────────────────────
# With no key the app still works: it answers from the labelled offline
# classifier. Free key: https://console.groq.com/keys
AI_ENABLED=true
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
# Tried when the primary model is rate-limited (429), down, or retired.
# Uncomment to use it — left unset by default, so a failing primary drops to the
# labelled offline classifier instead (README documents the default as unset).
# AI_FALLBACK_MODEL=qwen/qwen3.8-27b
AI_TIMEOUT_MS=15000
AI_OFFLINE_FALLBACK=true

# ── Password reset (self-service ADR-008 + Admin-initiated ADR-007) ──────────
# Self-service recovery: POST /auth/forgot-password mails a one-time link to the
# account's address. With no provider configured the link is printed to the
# backend console (and shown in the UI outside production). For real email, set
# the SMTP block below — or MAIL_WEBHOOK_URL / RESEND_API_KEY (see backend/README).
# Gmail:   smtp.gmail.com           Outlook/Hotmail: smtp-mail.outlook.com
# Use an APP PASSWORD (not your normal login) when 2-factor auth is on.
# One-command Gmail setup + a live test send: node scripts/setup-mail.mjs
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Eurisko Hub <no-reply@eurisko.local>

# ── Second sender (optional backup, ADR-008) ─────────────────────────────────
# A second SMTP server, tried when the first one fails (e.g. Gmail primary,
# Outlook backup — or the other way round). Same variables, SMTP_ALT_ prefix.
# SMTP_ALT_FROM should be the alternate account's own address: Gmail rewrites a
# mismatched sender to the authenticated account and some servers reject it.
SMTP_ALT_HOST=
SMTP_ALT_PORT=587
SMTP_ALT_SECURE=false
SMTP_ALT_USER=
SMTP_ALT_PASS=
SMTP_ALT_FROM=Eurisko Hub <no-reply@eurisko.local>

# Optional extras for either SMTP block: a From override per sender and the
# connection timeout in milliseconds (default 20000).
# SMTP_FROM=Eurisko Hub <you@gmail.com>
# SMTP_TIMEOUT_MS=20000
# SMTP_ALT_TIMEOUT_MS=20000

# ── Other transports (alternatives to SMTP; tried after both SMTP blocks) ────
# Any HTTPS endpoint that accepts a JSON { to, subject, text } body:
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_TOKEN=            # optional Authorization: Bearer <token>
# Resend's HTTP API (https://resend.com) — no app passwords or 2FA needed.
# Until a domain is verified at resend.com/domains, Resend only delivers from
# onboarding@resend.dev to the address the Resend account was created with.
# RESEND_API_KEY=re_…
# MAIL_FROM=Eurisko Hub <onboarding@resend.dev>

# An Admin can still mint a link for a colleague in the app (Users → Reset
# password), and a locked-out lone Admin can run scripts/reset-password.mjs.
# APP_BASE_URL is the origin the reset link points at; the TTL is how long the
# one-time token stays valid.
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
# Outside production the reset token is also returned in the API response.
# Set to false to disable that. NODE_ENV=production always disables it.
PASSWORD_RESET_RETURN_TOKEN=true
# At most one forgot-password email per address per this many seconds
# (anti mail-bomb; an in-memory window — a restart merely resets it).
PASSWORD_RESET_COOLDOWN_SECONDS=60
