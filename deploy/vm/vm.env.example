# Eurisko Hub - VM deployment settings.
#
# Copy to `vm.env` (same directory, git-ignored) and edit before running
# bootstrap.sh. Every value is optional: bootstrap.sh generates or derives
# anything you leave out.

# The public hostname Caddy serves and gets a certificate for.
# Leave unset to derive it from the VM's public IP as <dashed-ip>.sslip.io.
# If you own a domain, point an A record at the VM and set it here instead.
#SITE_ADDRESS=hub.example.com

# Admin account seeded on first boot. Leave unset and bootstrap.sh generates a
# strong random password and prints it once at the end.
#ADMIN_EMAIL=admin@eurisko.com
#ADMIN_PASSWORD=

# Contact address for Let's Encrypt expiry notices. Optional but recommended.
#ACME_EMAIL=you@example.com

# Git revision to deploy. Defaults to the repository's default branch.
# Pin it to freeze the deployment to the exact revision in the submission:
#GIT_REF=90f722aa52ef90f255862559015535897375bd89
