# Runtime database files (sql.js/SQLite) — never commit local state
backend/.data/

# Installed dependencies at any depth — never committed. The committed
# package-lock.json files are what recreate them identically (`npm ci`).
node_modules/

# Frontend (Vite + React)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# E2E tooling (Playwright) + screenshots
e2e/node_modules/
e2e/.browsers/

# Generated evidence (test logs, screenshots, recovery transcripts, exports) is
# working material: it is regenerated by `node scripts/collect-evidence.mjs` and
# `node scripts/prove-recovery.mjs`, and it carries timestamps and large binaries.
# `artifacts/*` (not `artifacts/`) is used deliberately: git cannot re-include a
# file inside an excluded directory, and the capstone brief asks for
# `artifacts/submission-email.md` to be part of the repository.
artifacts/*
!artifacts/submission-email.md

# Local system libraries fetched while probing a browser (Playwright deps)
.probe-libs/

# npm workspace-local cache
.npm-cache/

# Logs / env
*.log
.env
.DS_Store

# Private study handbook (personal notes, generated) — never publish
*.docx
scripts/make-handover-docx.mjs
